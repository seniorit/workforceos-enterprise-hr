rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Departments
    match /departments/{departmentId} {
      allow read, write: if isValidId(departmentId);
    }

    // Employees
    match /employees/{employeeId} {
      allow read, write: if isValidId(employeeId);
    }

    // Payrolls
    match /payrolls/{payrollId} {
      allow read, write: if isValidId(payrollId);
    }

    // Attendances
    match /attendances/{attendanceId} {
      allow read, write: if isValidId(attendanceId);
    }

    // System Users
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Settings (Dashboard & Currency)
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }
  }
}

