rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDepartment(data) {
      return data.keys().hasAll(['name', 'code']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.code is string && data.code.size() > 0 && data.code.size() <= 20 &&
        (!('head_of_department' in data) || (data.head_of_department is string && data.head_of_department.size() <= 100)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('budget' in data) || (data.budget is number)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 20)) &&
        (!('employee_count' in data) || (data.employee_count is number));
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['full_name', 'department']) &&
        data.full_name is string && data.full_name.size() > 0 && data.full_name.size() <= 150 &&
        data.department is string && data.department.size() > 0 && data.department.size() <= 100 &&
        (!('job_title' in data) || (data.job_title is string && data.job_title.size() <= 100)) &&
        (!('work_email' in data) || (data.work_email is string && data.work_email.size() <= 150)) &&
        (!('phone_number' in data) || (data.phone_number is string && data.phone_number.size() <= 50)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 20));
    }

    function isValidPayroll(data) {
      return data.keys().hasAll(['employee_name', 'net_pay']) &&
        data.employee_name is string && data.employee_name.size() > 0 && data.employee_name.size() <= 150 &&
        data.net_pay is number;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['employee_id', 'date', 'status']) &&
        data.employee_id is string && data.employee_id.size() > 0 && data.employee_id.size() <= 50 &&
        data.date is string && data.date.size() > 0 && data.date.size() <= 20 &&
        data.status is string && data.status.size() > 0 && data.status.size() <= 50;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['full_name', 'email', 'role']) &&
        data.full_name is string && data.full_name.size() > 0 && data.full_name.size() <= 150 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        data.role is string && data.role.size() > 0 && data.role.size() <= 50;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Departments
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(departmentId) && isValidDepartment(incoming());
      allow delete: if isSignedIn() && isValidId(departmentId);
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(employeeId) && isValidEmployee(incoming());
      allow delete: if isSignedIn() && isValidId(employeeId);
    }

    // Payrolls
    match /payrolls/{payrollId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(payrollId) && isValidPayroll(incoming());
      allow delete: if isSignedIn() && isValidId(payrollId);
    }

    // Attendances
    match /attendances/{attendanceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(incoming());
      allow delete: if isSignedIn() && isValidId(attendanceId);
    }

    // System Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId) && isValidUser(incoming());
      allow delete: if isSignedIn() && isValidId(userId);
    }
  }
}
